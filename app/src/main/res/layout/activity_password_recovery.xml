<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Khôi phục mật khẩu" android:textSize="20sp" android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/edEmail"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:hint="Email đã đăng ký" android:inputType="textEmailAddress"/>

    <Button
        android:id="@+id/btnSend"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="Gửi email đặt lại mật khẩu"
        android:textColor="#FFFFFF" android:backgroundTint="#3F51B5"
        android:layout_marginTop="12dp"/>
</LinearLayout>
