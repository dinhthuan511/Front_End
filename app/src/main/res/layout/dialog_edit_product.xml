<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <EditText android:id="@+id/edtName"  android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="productName" />

        <EditText android:id="@+id/edtAuthor" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="author" android:layout_marginTop="8dp"/>

        <EditText android:id="@+id/edtPrice" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number"
            android:hint="price" android:layout_marginTop="8dp"/>

        <EditText android:id="@+id/edtStock" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number"
            android:hint="stock" android:layout_marginTop="8dp"/>

        <EditText android:id="@+id/edtCategoryId" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number"
            android:hint="categoryId" android:layout_marginTop="8dp"/>

        <EditText android:id="@+id/edtIsbn" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="isbn" android:layout_marginTop="8dp"/>

        <EditText android:id="@+id/edtImageURL" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="imageURL" android:layout_marginTop="8dp"/>

        <EditText android:id="@+id/edtBrief" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minLines="2" android:gravity="top"
            android:hint="briefDescription" android:layout_marginTop="8dp"/>

        <EditText android:id="@+id/edtFull" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minLines="3" android:gravity="top"
            android:hint="fullDescription" android:layout_marginTop="8dp"/>

        <EditText android:id="@+id/edtSpecs" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minLines="2" android:gravity="top"
            android:hint="technicalSpecifications" android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
