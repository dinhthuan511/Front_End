<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nút quay lại -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/outline_arrow_back_24"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thanh toán VNPay"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Thông tin người nhận -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông tin giao hàng:"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtCustomerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên: ...\nSĐT: ...\nĐịa chỉ: ..." />

        <!-- Tổng tiền -->
        <TextView
            android:id="@+id/txtTotalVNPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tổng cộng: 0 VND"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="end"
            android:layout_marginTop="8dp" />

        <!-- Nhập số tài khoản -->
        <EditText
            android:id="@+id/edtBankAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập số tài khoản ngân hàng"
            android:inputType="number" />

        <!-- Kiểm tra lại đơn hàng -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kiểm tra lại đơn hàng"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerVNPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- Nút xác nhận -->
        <Button
            android:id="@+id/btnPayVNPay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xác nhận thanh toán VNPay"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/teal_700"
            android:textColor="#FFF" />
    </LinearLayout>
</ScrollView>
