<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Book_Store_MobileApp">
        <activity
            android:name=".network.Firebase"
            android:exported="false" />
        <!-- Admin/Store/…: không có intent-filter => exported=false -->
        <activity
            android:name=".AdminActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".BookDetailActivity"
            android:exported="false" />
        <activity
            android:name=".CartActivity"
            android:exported="false" /> <!-- Chỉ Login có LAUNCHER nên exported=true -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".UserProfileActivity"
            android:exported="false" />

        <activity
            android:name=".StoreActivity"
            android:exported="true">    <!-- mở app đẩy thẳng vào trang home -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>