<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền cần thiết -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nếu không dùng location, có thể cân nhắc bỏ bớt 2 quyền dưới để giảm prompt permission -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Book_Store_MobileApp">

        <!-- Ko có API key (placeholder) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_API_KEY" />

        <!-- App screens (exported=false vì không có intent-filter public) -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- Giữ nguyên theo yêu cầu -->
<!--        <activity-->
<!--            android:name=".network.Firebase"-->
<!--            android:exported="false" />-->
        <!-- Admin/Store/…: không có intent-filter => exported=false -->

        <!-- Admin (đang dùng package ui.admin) -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AddEditProductActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.AdminProductsActivity"
            android:exported="false" />

        <!-- User flows -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.AccountSecurityActivity"
            android:exported="false" />
        <activity
            android:name=".AddressActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.ChangePasswordActivity"
            android:exported="false" />
        <activity
            android:name=".BookDetailActivity"
            android:exported="false" />
        <activity
            android:name=".CartActivity"
            android:exported="false" />
        <activity
            android:name=".StoreActivity"
            android:exported="false" />
<!--        <activity-->
<!--            android:name=".PasswordRecoveryActivity"-->
<!--            android:exported="false"/>-->

        <!-- Khối dưới là code cũ từng thử cho Store làm LAUNCHER; để comment là OK
        <activity
            android:name=".StoreActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        -->

        <!-- SPLASH LÀ LAUNCHER -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Book_Store_MobileApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
