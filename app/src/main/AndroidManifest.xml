<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" /> <!-- Quyền truy cập vị trí -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Book_Store_MobileApp">
        <activity
            android:name=".VNPayActivity"
            android:exported="false" />
        <activity
            android:name=".OrderStatusActivity"
            android:exported="false" />
        <activity
            android:name=".PaymentSuccessActivity"
            android:exported="false" />
        <activity
            android:name=".PaymentProcessingActivity"
            android:exported="false" />
        <activity
            android:name=".CheckoutActivity"
            android:exported="false" /> <!-- Ko có API key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_API_KEY" />

        <activity
            android:name=".HomeActivity"
            android:exported="false" /> <!-- <activity -->
        <!-- android:name=".network.Firebase" -->
        <!-- android:exported="false" /> &lt;!&ndash; Admin/Store/…: không có intent-filter => exported=false &ndash;&gt; -->
        <activity
            android:name=".AdminActivity"
            android:exported="false" />
        <activity
            android:name=".StoreActivity"
            android:exported="false" />
        <activity
            android:name=".BookDetailActivity"
            android:exported="false" />
        <activity
            android:name=".CartActivity"
            android:exported="false" /> <!-- Chỉ Login có LAUNCHER nên exported=true -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>