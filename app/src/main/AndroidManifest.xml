<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền truy cập -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Android 13+ notification runtime permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ZaloPaySDKInit"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Book_Store_MobileApp">

        <!-- Map API key, đừng xóa-->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDc7PnOq3Hxzq6dxeUVaY8WGLHIePl0swY" />

        <activity android:name=".CheckoutActivity" android:exported="false" />
        <!-- ✅ ZaloPay Callback Activity -->
        <activity
            android:name=".ZaloPayActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar">
            <intent-filter>
                <data android:scheme="zalopay2554" android:host="app" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
        </activity>

        <!-- ✅ Screens -->
        <activity android:name=".PaymentSuccessActivity" android:exported="false" />
        <activity android:name=".PaymentProcessingActivity" android:exported="false" />
        <activity android:name=".OrderDetailActivity" android:exported="false" />
        <activity android:name=".OrderStatusActivity" android:exported="false" />
        <activity android:name=".CartActivity" android:exported="false" />
        <activity android:name=".OrderListActivity" android:exported="false" />
        <activity android:name=".HomeActivity" android:exported="false" />
        <activity android:name=".BookDetailActivity" android:exported="false" />


        <!-- ✅ Admin -->
        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminOrdersActivity" android:exported="false" />
        <activity
            android:name=".ui.admin.AdminProductsActivity" android:exported="false" />
        <activity
            android:name=".ui.admin.EditProductActivity" android:exported="false"
             />
        <activity android:name=".ui.admin.AddProductActivity" android:exported="false"
             />
        <!-- ✅ Auth / Profile -->
        <activity
            android:name=".ui.auth.LoginActivity" android:exported="false" />

        <activity
            android:name=".ui.auth.RegisterActivity" android:exported="false" />

        <activity
            android:name=".ui.auth.ProfileActivity" android:exported="false"
            />

        <activity
            android:name=".ui.auth.AccountSecurityActivity"
            android:exported="false"
            android:parentActivityName=".ui.auth.ProfileActivity" />

        <activity
            android:name=".ui.auth.ChangePasswordActivity" android:exported="false" />

        <activity
            android:name=".ui.auth.VerifyEmailActivity" android:exported="false"
            />

        <activity android:name=".NotificationCenterActivity" android:exported="false" />
        <activity android:name=".ChatActivity" android:exported="false" />

        <!-- ✅ StoreActivity là màn hình mở đầu -->
        <activity
            android:name=".StoreActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


    </application>

</manifest>
